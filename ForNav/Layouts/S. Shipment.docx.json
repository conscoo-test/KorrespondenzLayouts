          "Controls": {
            "Header_FieldGroups_Bill_toAddress6": {
              "@Name": "Header_FieldGroups_Bill_toAddress6",
              "@ControlType": "TextBox",
              "@Size": "1700,250",
              "@Location": "0,0",
              "@Dpi": "254",
              "@Font": "Segoe UI, 8pt",
              "@BackColor": "White",
              "@HorzAlign": "Center",
              "@ShowOutput": "CurrReport.PrintLogo(ForNAVSetup.UsePreprintedPaper)",
              "@MultiLine": "true",
              "@SourceExpression": [
                "var joinFormat = ': ';",
                "",
                "var Line1 = '<b>' + CompanyInformation.Name + '</b><br>';",
                "",
                "var Line2 = CurrReport.JoinStrings(' | ',",
                "    CompanyInformation.Address, ",
                "    `${CompanyInformation.PostCode} ${CompanyInformation.City}`, ",
                "    CompanyInformation.FieldExtensions.PhoneNo.Format(joinFormat),",
                "    CompanyInformation.FieldExtensions.FaxNo.Format(joinFormat),",
                "    CompanyInformation.FieldExtensions.E_Mail.Format(joinFormat)",
                ") + '<br>';",
                "",
                "var Line3 = CurrReport.JoinStrings(' | ',",
                "    `<b>${CompanyInformation.FieldCaptions.lbtTradeRegisterName}:</b> ${CompanyInformation.lbtTradeRegisterName} ${CompanyInformation.lbtCommercialRegisterNo}`,",
                "    `<b>${CompanyInformation.FieldCaptions.lbtCEO1}:</b> ${CompanyInformation.lbtCEO1}${CompanyInformation.lbtCEO2?\", \"+CompanyInformation.lbtCEO2:\"\"}${CompanyInformation.lbtCEO3?\", \"+CompanyInformation.lbtCEO3:\"\"}`",
                ") + '<br>';",
                "",
                "var Line4 = CompanyInformation.BankName ? (CurrReport.JoinStrings(' | ',",
                "    `<b>${CompanyInformation.FieldCaptions.BankName}</b> ${CompanyInformation.BankName}`,",
                "    `<b>${CompanyInformation.FieldCaptions.IBAN}</b> ${CompanyInformation.IBAN}`,",
                "    (CompanyInformation.SWIFTCode != \"\") ? `<b>${CompanyInformation.FieldCaptions.SWIFTCode}</b> ${CompanyInformation.SWIFTCode}` : \"\"",
                ") + '<br>') : '';",
                "",
                "var Line5 = CompanyInformation.lbtBankName2 ? (CurrReport.JoinStrings(' | ',",
                "    `<b>${CompanyInformation.FieldCaptions.BankName}</b> ${CompanyInformation.lbtBankName2}`,",
                "    `<b>${CompanyInformation.FieldCaptions.IBAN}</b> ${CompanyInformation.lbtIBAN2}`,",
                "    (CompanyInformation.lbtSWIFTCode2 != \"\") ? `<b>${CompanyInformation.FieldCaptions.SWIFTCode}</b> ${CompanyInformation.lbtSWIFTCode2}` : \"\"",
                ") + '<br>') : '';",
                "",
                "var Line6 = CompanyInformation.lbtBankName3 ? (CurrReport.JoinStrings(' | ',",
                "    `<b>${CompanyInformation.FieldCaptions.BankName}</b> ${CompanyInformation.lbtBankName3}`,",
                "    `<b>${CompanyInformation.FieldCaptions.IBAN}</b> ${CompanyInformation.lbtIBAN3}`,",
                "    (CompanyInformation.lbtSWIFTCode3 != \"\") ? `<b>${CompanyInformation.FieldCaptions.SWIFTCode}</b> ${CompanyInformation.lbtSWIFTCode3}`: \"\"",
                ")) : '';",
                "",
                "var Line7 = CurrReport.JoinStrings(' | ',",
                "    `<b>${CompanyInformation.FieldCaptions.VATRegistrationNo}:</b> ${CompanyInformation.VATRegistrationNo}`",
                ") + '<br>';",
                "",
                "'<!DOCTYPE><div style=\"font-family: Segoe UI; font-size: 8pt;\">'",
                "+ Line1",
                "+ Line2",
                "+ Line3",
                "+ Line7",
                "+ Line4",
                "+ Line5",
                "+ Line6",
                ""
              ],
              "@CanShrink": "true"
            }
          }
        },
