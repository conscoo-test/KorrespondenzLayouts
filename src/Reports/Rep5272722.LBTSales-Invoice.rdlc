                                  <TablixMember>
                                    <Group Name="No_SalesInvHdr">
                                      <GroupExpressions>
                                        <GroupExpression>=Fields!No_SalesInvHdr.Value</GroupExpression>
                                        <GroupExpression>=Fields!OutputNo.Value</GroupExpression>
                                        <GroupExpression>=Fields!NewPageGroup.Value</GroupExpression>
                                      </GroupExpressions>
                                      <PageBreak>
                                        <BreakLocation>Between</BreakLocation>
                                      </PageBreak>
                                    </Group>
                                    <SortExpressions>
                                      <SortExpression>
                                        <Value>=Fields!No_SalesInvHdr.Value</Value>
                                      </SortExpression>
                                    </SortExpressions>
                                    <TablixMembers>
                                      <TablixMember>
                                        <KeepWithGroup>After</KeepWithGroup>
                                      </TablixMember>
                                      <TablixMember>
                                        <Group Name="Table_Lines_Group1">
                                          <GroupExpressions>
                                            <GroupExpression>=Fields!No_SalesInvHdr.Value</GroupExpression>
                                            <GroupExpression>=Fields!OutputNo.Value</GroupExpression>
                                            <GroupExpression>=Fields!NewPageGroup.Value</GroupExpression>
                                            <GroupExpression>=Fields!LineNo_SalesInvoiceLine.Value</GroupExpression>
                                          </GroupExpressions>
                                        </Group>
                                        <SortExpressions>
                                          <SortExpression>
                                            <Value>=Fields!No_SalesInvHdr.Value</Value>
                                          </SortExpression>
                                          <SortExpression>
                                            <Value>=Fields!OutputNo.Value</Value>
                                          </SortExpression>
                                          <SortExpression>
                                            <Value>=Fields!LineNo_SalesInvoiceLine.Value</Value>
                                          </SortExpression>
                                        </SortExpressions>
                                        <TablixMembers>
                                          <TablixMember>
                                            <Visibility>
                                              <Hidden>=Iif((Fields!SalesLineType.Value &lt;&gt; "0") or
     ((Fields!SalesLineType.Value = "0") and
          ((Fields!SalesLineLeBitPrintoption.Value = "1") or
           (Fields!SalesLineLeBitPrintoption.Value = "3") or
           (Fields!SalesLineLeBitPrintoption.Value = "5") or
           (Fields!SalesLineLeBitPrintoption.Value = "6") or
           (Fields!SalesLineLeBitPrintoption.Value = "8") or
           (Fields!SalesLineLeBitPrintoption.Value = "9"))), false, true)</Hidden>
                                            </Visibility>
                                          </TablixMember>
                                          <TablixMember>
                                            <Visibility>
                                              <Hidden>=Iif((Fields!SalesLineType.Value = "0") and
     (Fields!SalesLineLeBitPrintoption.Value = "0"),false, true)</Hidden>
                                            </Visibility>
                                            <KeepTogether>true</KeepTogether>
                                          </TablixMember>
                                          <TablixMember>
                                            <Visibility>
                                              <Hidden>=Iif((Fields!SalesLineType.Value = "0") and
