                                        <Group Name="Table_Lines_Group1">
                                          <GroupExpressions>
                                            <GroupExpression>=Fields!DocType_SalesHeader.Value</GroupExpression>
                                            <GroupExpression>=Fields!No_SalesHeader.Value</GroupExpression>
